						"          UnitPrice as long,",
						"          TotalAmount as long",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     format: 'parquet') ~> sourcebronze",
						"filterlessthan100 derive(Domain = split(CustomerEmail ,'@')) ~> Domain",
						"Domain derive(Domain = slice(Domain,2)[1]) ~> DomainAonly",
						"sourcebronze filter(UnitPrice >=100) ~> filterlessthan100",
						"DomainAonly sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     format: 'parquet',",
						"     umask: 0022,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> SilverDestination"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('workspaceId'), '/datasets/DS_Parquet_bronze')]",
				"[concat(variables('workspaceId'), '/datasets/DS_silver_Parquet')]"
			]
		},
		{
			"name": "[concat(parameters('workspaceName'), '/WorkspaceSystemIdentity')]",
			"type": "Microsoft.Synapse/workspaces/credentials",
